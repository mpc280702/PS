{
  "manifestVersion": 5,
  "id": "com.photoshop.ai.layersplitter",
  "name": "AI Auto Layer Splitter",
  "version": "2.3.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "24.0.0",
    "data": {
      "apiVersion": 2
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "aiLayerPanel",
      "label": {
        "default": "AI Layer Splitter"
      },
      "minimumSize": {
        "width": 260,
        "height": 400
      },
      "maximumSize": {
        "width": 520,
        "height": 800
      },
      "preferredDockedSize": {
        "width": 300,
        "height": 470
      },
      "preferredFloatingSize": {
        "width": 340,
        "height": 500
      }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": [
        "http://127.0.0.1:5000",
        "http://localhost:5000"
      ]
    },
    "localFileSystem": "fullAccess"
  }
}
