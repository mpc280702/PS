{
  "manifestVersion": 5,
  "id": "com.photoshop.ai.layersplitter",
  "name": "AI Auto Layer Splitter",
  "version": "1.0.0",
  "main": "index.html",
  "host": [
    {
      "app": "PS",
      "minVersion": "24.0.0",
      "data": {
        "apiVersion": 2
      }
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "aiLayerPanel",
      "label": {
        "default": "AI Layer Splitter"
      },
      "minimumSize": { "width": 260, "height": 350 },
      "maximumSize": { "width": 450, "height": 650 },
      "preferredDockedSize": { "width": 280, "height": 400 }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": "all"
    },
    "localFileSystem": "fullAccess"
  }
}
